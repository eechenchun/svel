# BEGIN SvelCMS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^storage/(?!uploads/).* - [F,L]
    RewriteRule ^(dist|shichang|docs)/ - [F,L]
    RewriteRule ^config/ - [F,L]

    RewriteRule ^ index.php [L]
</IfModule>
<FilesMatch "^(config\.php|install\.php|install\.lock|\.user\.ini|\.htaccess|.*\.db|.*\.sqlite|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
# END SvelCMS



